# The app works without any key (rule-based planner). Add ONE key to switch on the LangChain LLM agent.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER=anthropic        # anthropic or openai (auto-detected from the key)
# LLM_MODEL=claude-sonnet-4-5   # any tool-calling chat model your provider offers
# TRAVEL_DATA_DIR=./data
# TRAVEL_DB_PATH=./trips.db
GROQ_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile